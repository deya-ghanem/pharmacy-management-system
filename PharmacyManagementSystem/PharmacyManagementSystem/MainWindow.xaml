<Window x:Class="PharmacyManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy Management System"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="Pharmacy Management System"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Medicine and Sales Management"
                       FontSize="14" Foreground="#64748B"/>
        </StackPanel>

        <TabControl Grid.Row="1" FontSize="14">

            <!-- MEDICINE MANAGEMENT -->
            <TabItem Header="Medicine Management">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White"
                            CornerRadius="8" Padding="15"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Medicine Details"
                                       FontSize="18" FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Medicine Name"/>
                            <TextBox x:Name="txtName" Height="32" Margin="0,5,0,10"/>

                            <TextBlock Text="Barcode"/>
                            <TextBox x:Name="txtBarcode" Height="32" Margin="0,5,0,10"/>

                            <TextBlock Text="Price"/>
                            <TextBox x:Name="txtPrice" Height="32" Margin="0,5,0,10"/>

                            <TextBlock Text="Quantity"/>
                            <TextBox x:Name="txtQuantity" Height="32" Margin="0,5,0,10"/>

                            <TextBlock Text="Expiry Date (YYYY-MM-DD)"/>
                            <TextBox x:Name="txtExpiryDate" Height="32" Margin="0,5,0,15"/>

                            <Button x:Name="btnAdd" Content="Add Medicine"
                                    Height="38" Margin="0,0,0,8"
                                    Background="#2563EB" Foreground="White"/>

                            <Button x:Name="btnUpdate" Content="Update Selected"
                                    Height="38" Margin="0,0,0,8"
                                    Background="#0F766E" Foreground="White"/>

                            <Button x:Name="btnDelete" Content="Delete Selected"
                                    Height="38" Margin="0,0,0,8"
                                    Background="#DC2626" Foreground="White"/>

                            <Button x:Name="btnClear" Content="Clear Fields"
                                    Height="35"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White"
                            CornerRadius="8" Padding="15">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Medicine List"
                                           FontSize="18" FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtSearch"
                                             Height="35" Padding="8"
                                             Margin="0,0,8,0"/>

                                    <Button x:Name="btnSearch"
                                            Grid.Column="1"
                                            Content="Search"
                                            Height="35"
                                            Background="#2563EB"
                                            Foreground="White"/>
                                </Grid>
                            </StackPanel>

                            <DataGrid x:Name="dgMedicines"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      RowHeight="35">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="100"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="70"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="75"/>
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SALES -->
            <TabItem Header="Sales">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Create New Sale"
                               FontSize="22" FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Select Medicine"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbMedicine"
                                  Height="40"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="Quantity"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSaleQuantity"
                                 Height="40"
                                 Padding="10"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <Button x:Name="btnCreateSale"
                                Content="Confirm Sale"
                                Height="45"
                                Background="#0F766E"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"/>

                        <TextBlock x:Name="txtSaleStatus"
                                   Margin="0,15,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
